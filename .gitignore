# 実際の設定ファイル（APIキー・個人パスを含む可能性があるもの）はコミットしない
# テンプレートは *.example.* として管理する
configs/**/*.local.*
configs/**/config.json
!configs/**/*.example.*
tools/launcher/launcher.config.json
!tools/launcher/launcher.config.example.json

# MOD本体・アーカイブ・音声モデルは含めない
*.7z
*.zip
*.rar
*.ba2
*.esm
*.esp
*.esl
*.dll
*.exe
*.onnx
*.pth
*.safetensors
*.aivmx
*.gguf
*.strings
*.dlstrings
*.ilstrings

# スクラッチ作業ディレクトリ
scratch/

# 生成音声・ログ
*.wav
*.mp3
tools/launcher/logs/
logs/
*.log

# Python
__pycache__/
.venv/
